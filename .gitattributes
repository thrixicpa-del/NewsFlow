# Normalize text while preserving Windows-native script endings.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: do not line-diff or normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.dll binary
*.pyd binary
*.zip binary
*.7z binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.mov binary
*.mkv binary

# Required local build asset. Kept separately from generated user media.
assets/ffmpeg.exe filter=lfs diff=lfs merge=lfs -text
