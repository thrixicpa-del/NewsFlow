{
  "name": "newsflow-studio",
  "version": "2.1.152",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:web": "tsc --noEmit && vite build",
    "build:desktop": "tsc -p electron/tsconfig.json",
    "build:remotion": "node scripts/build-remotion.mjs",
    "build": "pnpm build:web && pnpm build:desktop && pnpm build:remotion",
    "desktop": "pnpm build && electron .",
    "verify:remotion-native-assets": "node scripts/verify-remotion-native-assets.mjs",
    "verify:security": "node scripts/security-gate.mjs",
    "verify:secrets": "python ../scripts/secret-scan.py",
    "verify:dependencies": "pnpm audit --prod --audit-level=high",
    "prepare:immutable-rc": "node scripts/prepare-immutable-rc.mjs",
    "finalize:immutable-rc": "node scripts/finalize-immutable-rc.mjs",
    "package:preview": "node scripts/package-immutable-rc.mjs --type TEST --rc 01 --target portable",
    "package:release": "node scripts/package-immutable-rc.mjs --type RC --rc 01 --target nsis",
    "verify:build-runtime": "node scripts/verify-build-runtime.mjs",
    "verify:core-runtime": "node scripts/verify-core-runtime.mjs",
    "verify:ideas-v2-ui": "node scripts/verify-ideas-v2-ui.mjs",
    "verify:custom-direction-ui": "node scripts/verify-custom-direction-ui.mjs",
    "verify:portable": "node scripts/verify-portable.mjs",
    "verify:montage-ui": "node scripts/verify-montage-ui-contract.mjs",
    "verify:remotion-runtime": "node scripts/verify-remotion-runtime-contract.mjs",
    "verify:workstation-visuals": "set \"NEWSFLOW_TEST_MODE=1\" && electron scripts/capture-workstation-baselines.mjs",
    "test:ui": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remotion/bundler": "4.0.515",
    "@remotion/cli": "4.0.515",
    "@remotion/media": "4.0.515",
    "@remotion/renderer": "4.0.515",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.515",
    "tailwind-merge": "^3.6.0",
    "typescript": "7.0.2",
    "unzipper": "0.12.5",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.0",
    "axe-core": "4.13.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "jsdom": "^30.0.1",
    "storybook": "10.4.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "ru.newsflow.studio",
    "productName": "NewsFlow Studio",
    "directories": { "output": "release-staging" },
    "npmRebuild": false,
    "files": ["dist/**/*", "dist-electron/**/*", "remotion/**/*", "remotion-bundle/**/*", "package.json"],
    "asarUnpack": ["remotion/render.mjs", "remotion-bundle/**/*"],
    "extraResources": [
      { "from": "../scriptor", "to": "core/scriptor" },
      { "from": "D:/NewsFlow-RC/core-bin-2.1.152-observability-r42/NewsFlowCore", "to": "core-bin" },
      { "from": "D:/NewsFlow-RC/core-bin-2.1.152-observability-r42/NewsFlowCore/_internal/_tcl_data", "to": "core-tcl-data" },
      { "from": "node_modules/.pnpm/@remotion+compositor-win32-x64-msvc@4.0.515/node_modules/@remotion/compositor-win32-x64-msvc", "to": "remotion-binaries" }
    ],
    "win": { "target": "portable", "icon": "../assets/scriptor.ico" }
  },
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24.19.0 <25" }
}
